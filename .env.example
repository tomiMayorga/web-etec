# El proyecto no carga este archivo automáticamente.
# Estos valores documentan la configuración admitida por el proceso.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Base de datos local. En producción se reemplaza por PostgreSQL.
DATABASE_URL=file:./dev.db

# Generar valores independientes con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=reemplazar-por-un-secreto-de-al-menos-32-caracteres
PII_ENCRYPTION_KEY=reemplazar-por-32-bytes-en-base64
PII_LOOKUP_KEY=reemplazar-por-otros-32-bytes-en-base64
AUDIT_IP_KEY=reemplazar-por-otros-32-bytes-en-base64

# Privacidad y conservación
PRIVACY_NOTICE_VERSION=2026-01
DATA_RETENTION_MONTHS=24

# Correo: completar al elegir el proveedor SMTP
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ingreso@etec.uba.ar

# Ruta opcional al JSON local de postulantes.
# SORTEO_DATA_PATH=C:\ruta\privada\postulantes-sorteo.json
