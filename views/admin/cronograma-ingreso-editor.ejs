<section class="admin-authorities-editor admin-admission-schedule-editor">
  <div class="admin-section-heading">
    <h2>Cronograma del ingreso</h2>
    <p>La tabla sigue el mismo orden que la página pública. Editá una fila y guardala; desmarcá «Visible» para ocultarla.</p>
    <a class="form-button form-button-secondary" href="/cronograma-curso-ingreso" target="_blank" rel="noopener">Ver cronograma público</a>
  </div>
  <% if (!Array.isArray(secciones)) { %>
    <div class="form-alert" role="alert">No se pudo cargar el cronograma. Recargá la página para volver a intentarlo.</div>
  <% } else { %>
    <%
      const cabecera = secciones.find((fila) => fila.grupo === 'Cabecera');
      const filas = secciones.filter((fila) => fila.grupo !== 'Cabecera');
      const formatos = [['Normal', 'Actividad habitual'], ['Evaluación', 'Evaluación / resultado destacado'], ['Alerta', 'Aviso / sin clases']];
      const siguienteOrden = Math.min(9999, Math.max(0, ...filas.map((fila) => fila.orden)) + 10);
    %>
    <% if (cabecera) { %>
      <details class="admin-editable-section">
        <summary><span><strong>Título y subtítulo</strong><small>Textos que aparecen arriba de la tabla pública.</small></span><span>Editar</span></summary>
        <form class="admin-settings-form" method="post" action="/admin/contenidos/cronograma-ingreso">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= cabecera.id %>"><input type="hidden" name="grupo" value="Cabecera"><input type="hidden" name="orden" value="0">
          <div class="form-field"><label for="cronograma-titulo">Título de la tabla</label><input id="cronograma-titulo" name="titulo" value="<%= cabecera.titulo %>" maxlength="160" required></div>
          <div class="form-field"><label for="cronograma-subtitulo">Subtítulo</label><input id="cronograma-subtitulo" name="contenido" value="<%= cabecera.contenido %>" maxlength="2000" required></div>
          <button type="submit" class="form-button form-button-primary">Guardar encabezado</button>
        </form>
      </details>
    <% } %>
    <details class="admin-calendar-block">
      <summary><h3>Fechas y actividades (<%= filas.length %>)</h3><span>Editar tabla <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span></summary>
      <p class="admin-schedule-help">La posición determina el orden de las actividades, no la fecha. Usamos saltos de 10 (10, 20, 30…) para poder intercalar actividades sin renumerar las demás: por ejemplo, una actividad con posición 15 aparece entre las posiciones 10 y 20. Cuanto menor sea el número, más arriba aparece. Si no querés cambiar el orden, dejá el valor actual. La fecha admite períodos como «25-Jul y 1-Ago».</p>
      <% filas.forEach((fila) => { %>
        <form id="cronograma-fila-<%= fila.id %>" class="admin-calendar-row-form" method="post" action="/admin/contenidos/cronograma-ingreso">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= fila.id %>">
        </form>
      <% }) %>
      <div class="admin-table-wrapper">
        <table class="admin-table admin-schedule-table">
          <caption class="admin-schedule-help">Cada fila corresponde a una fecha del cronograma público.</caption>
          <thead><tr><th scope="col">Fecha / período</th><th scope="col">Actividad / detalle</th><th scope="col">Formato</th><th scope="col">Posición</th><th scope="col">Visible</th><th scope="col">Acción</th></tr></thead>
          <tbody>
            <% filas.forEach((fila) => { %>
              <tr>
                <td><input form="cronograma-fila-<%= fila.id %>" name="titulo" aria-label="Fecha o período" maxlength="160" value="<%= fila.titulo %>" required></td>
                <td><textarea form="cronograma-fila-<%= fila.id %>" name="contenido" aria-label="Actividad o detalle" rows="3" maxlength="2000" required><%= fila.contenido %></textarea></td>
                <td><select form="cronograma-fila-<%= fila.id %>" name="grupo" aria-label="Formato de la actividad"><% formatos.forEach(([valor, etiqueta]) => { %><option value="<%= valor %>" <%= fila.grupo === valor ? 'selected' : '' %>><%= etiqueta %></option><% }) %></select></td>
                <td><input form="cronograma-fila-<%= fila.id %>" name="orden" aria-label="Posición en la tabla" type="number" min="0" max="9999" step="1" value="<%= fila.orden %>" required></td>
                <td><label class="admin-calendar-visible"><input form="cronograma-fila-<%= fila.id %>" name="activo" type="checkbox" <%= fila.activo ? 'checked' : '' %>> Sí</label></td>
                <td><button form="cronograma-fila-<%= fila.id %>" type="submit" class="form-button form-button-primary">Guardar fila</button></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </details>
    <details class="admin-create-panel admin-create-section-panel">
      <summary>+ Agregar fecha al cronograma</summary>
      <form class="admin-settings-form" method="post" action="/admin/contenidos/cronograma-ingreso">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="admin-edit-grid">
          <div class="form-field"><label for="cronograma-nueva-fecha">Fecha / período</label><input id="cronograma-nueva-fecha" name="titulo" maxlength="160" placeholder="Ej. 12 de Septiembre" required></div>
          <div class="form-field"><label for="cronograma-nuevo-formato">Formato</label><select id="cronograma-nuevo-formato" name="grupo"><% formatos.forEach(([valor, etiqueta]) => { %><option value="<%= valor %>"><%= etiqueta %></option><% }) %></select></div>
        </div>
        <div class="form-field"><label for="cronograma-nueva-actividad">Actividad / detalle</label><textarea id="cronograma-nueva-actividad" name="contenido" rows="3" maxlength="2000" placeholder="Ej. Clase de consulta" required></textarea></div>
        <div class="form-field"><label for="cronograma-nuevo-orden">Posición en la tabla</label><input id="cronograma-nuevo-orden" name="orden" type="number" min="0" max="9999" value="<%= siguienteOrden %>" required><span class="admin-field-help">Se propone agregar al final con un salto de 10. Para intercalar una actividad entre las posiciones 10 y 20, usá un número intermedio, por ejemplo 15; no necesitás cambiar las demás posiciones.</span></div>
        <div class="admin-toggle-row"><label><input type="checkbox" name="activo" checked> Mostrar en la página pública</label></div>
        <button class="form-button form-button-primary" type="submit">Agregar fecha</button>
      </form>
    </details>
  <% } %>
</section>
