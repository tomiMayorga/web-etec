<% const destinos={'Características Generales':'Condiciones y requisitos iniciales.','Acceso al Curso de Ingreso':'Sorteo, excepciones y asignación.','Sobre el Curso de Ingreso':'Días, horarios y funcionamiento.','Asistencia y Disciplina':'Asistencia y normas disciplinarias.','Obtención de vacantes para la ETEC':'Requisitos para obtener la vacante.','Conductas Transgresoras a las Reglas de Convivencia':'Conductas no permitidas.'}; const grupos=[...new Set(secciones.map(s=>s.grupo))]; %>
<section class="admin-authorities-editor"><div class="admin-section-heading"><div><h2>Reglamento del Curso de Ingreso</h2><p>Las seis secciones actuales están cargadas. Abrí una para editarla.</p></div><a class="form-button form-button-secondary" href="/reglamento" target="_blank" rel="noopener">Ver página pública</a></div><div class="admin-content-location"><strong>Qué modifica cada campo</strong><p>El título es el encabezado y el contenido reúne los párrafos y puntos de cada sección. Conservá los saltos de línea.</p></div><div class="admin-collapsible-grid"><% grupos.forEach(g=>{ %><details class="admin-editable-section"><summary><span><strong><%= g %></strong><small><%= destinos[g]||'Apartado adicional.' %></small></span><span>Editar</span></summary><% secciones.filter(s=>s.grupo===g).forEach(s=>{ %><form method="post" action="/admin/contenidos/secciones" class="admin-settings-card admin-settings-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= s.id %>"><input type="hidden" name="grupo" value="<%= s.grupo %>"><div class="form-field"><label>Título visible</label><input name="titulo" value="<%= s.titulo %>" maxlength="160" required></div><div class="form-field"><label>Texto y puntos de la sección</label><textarea name="contenido" rows="12" maxlength="2000" required><%= s.contenido %></textarea></div><div class="admin-toggle-row"><label><input type="checkbox" name="activo" <%= s.activo?'checked':'' %>> Mostrar esta sección</label></div><div class="form-actions"><button class="form-button form-button-primary" type="submit">Guardar esta sección</button></div></form><% }) %></details><% }) %></div><details class="admin-create-panel admin-create-section-panel"><summary>Agregar apartado</summary><form method="post" action="/admin/contenidos/secciones/nueva" class="admin-settings-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="paginaClave" value="reglamento-ingreso"><input type="hidden" name="grupo" value="Información adicional"><div class="form-field"><label>Título</label><input name="titulo" maxlength="160" required></div><div class="form-field"><label>Texto</label><textarea name="contenido" rows="8" maxlength="2000" required></textarea></div><button class="form-button form-button-primary" type="submit">Agregar y publicar</button></form></details></section>
