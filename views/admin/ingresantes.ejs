<%- include('../partials/header') %>
<main class="admin-management-page">
  <header class="admin-management-header"><div class="admin-dashboard-container"><div><p class="preinscripcion-kicker">SuperAdmin</p><h1>Ingresantes</h1><p>Importá un CSV y la página pública se actualizará con la tabla ordenada por número.</p></div><a class="form-button form-button-secondary" href="/admin/contenidos">Volver a Contenido del sitio</a></div></header>
  <div class="admin-dashboard-container admin-management-content">
    <% if (guardado) { %><div class="admin-save-message" role="status">La lista de ingresantes se importó correctamente.</div><% } %>
    <% if (error) { %><div class="form-alert form-alert-error" role="alert"><%= error %></div><% } %>
    <section class="admin-settings-card admin-settings-form">
      <h2>Cargar lista desde CSV</h2>
      <p class="form-help">El archivo debe tener una fila de encabezados y luego una fila por estudiante. Se aceptan comas, punto y coma o tabulaciones.</p>
      <p class="form-help">Columnas obligatorias: <code>Número</code>, <code>Apellido</code> y <code>Nombre</code>. Los números no deben repetirse. Ejemplo: <code>Número;Apellido;Nombre</code>.</p>
      <form method="post" action="/admin/ingresantes" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="admin-edit-grid"><div class="form-field"><label for="ingresantes-ciclo">Ciclo lectivo</label><input id="ingresantes-ciclo" name="cicloLectivo" type="number" min="2020" max="2100" value="<%= listado?.cicloLectivo || new Date().getFullYear() %>" required></div><div class="form-field"><label for="ingresantes-archivo">Archivo CSV</label><input id="ingresantes-archivo" name="archivo" type="file" accept=".csv,text/csv" required></div></div>
        <button class="form-button form-button-primary" type="submit">Importar y publicar tabla</button>
      </form>
    </section>
    <% if (listado) { %>
      <section class="admin-settings-card admin-settings-form"><h2>Lista actual: <%= listado.cicloLectivo %></h2><p class="form-help">Archivo: <%= listado.nombreArchivo %> · <%= listado.filas.length %> ingresantes. La importación nueva reemplaza esta lista.</p><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>N°</th><th>Apellido</th><th>Nombre</th></tr></thead><tbody><% listado.filas.slice(0, 200).forEach((fila) => { %><tr><td><%= fila.numero %></td><td><%= fila.apellido %></td><td><%= fila.nombre %></td></tr><% }) %></tbody></table></div><% if (listado.filas.length > 200) { %><p class="form-help">Se muestran los primeros 200 registros en la vista previa. La página pública muestra la lista completa.</p><% } %></section>
    <% } else { %><div class="form-alert">Todavía no hay una lista importada. La tabla pública usará temporalmente el listado local anterior.</div><% } %>
  </div>
</main>
<%- include('../partials/footer') %>
