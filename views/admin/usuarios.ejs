<%- include('../partials/header') %>
<main class="admin-management-page"><header class="admin-management-header"><div class="admin-dashboard-container"><div><p class="preinscripcion-kicker">SuperAdmin</p><h1>Usuarios administrativos</h1><p>Creá operadores y administrá sus permisos.</p></div><a class="form-button form-button-secondary" href="/admin">Volver al panel</a></div></header><div class="admin-dashboard-container admin-management-content"><section class="admin-settings-card"><h2>Crear usuario</h2><form method="post" action="/admin/usuarios" class="admin-settings-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="admin-edit-grid"><div class="form-field"><label for="nombreMostrado">Nombre visible</label><input id="nombreMostrado" name="nombreMostrado" minlength="2" maxlength="100" required></div><div class="form-field"><label for="email">Correo electrónico</label><input id="email" name="email" type="email" maxlength="254" required></div><div class="form-field"><label for="password">Contraseña temporal</label><input id="password" name="password" type="password" minlength="12" maxlength="128" required></div><div class="form-field"><label for="rol">Rol</label><select id="rol" name="rol"><option value="OPERADOR_INGRESO">Operador de ingreso</option><option value="SUPER_ADMIN">SuperAdmin</option></select></div></div><button class="form-button form-button-primary" type="submit">Crear usuario</button></form></section><section class="admin-management-section"><h2>Usuarios existentes</h2><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Nombre</th><th>Acceso</th><th>Rol</th><th>Estado</th><th>Acción</th></tr></thead><tbody><% usuarios.forEach((usuario) => { %><tr><td><%= usuario.nombreMostrado %></td><td><%= usuario.email %><% if (usuario.nombreUsuario) { %><br><small>Usuario: <%= usuario.nombreUsuario %></small><% } %></td><td><%= usuario.rol %></td><td><span class="admin-status-badge"><%= usuario.activo ? 'Activo' : 'Inactivo' %></span></td><td><% if (usuario.id !== usuarioActualId) { %><form method="post" action="/admin/usuarios/estado"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= usuario.id %>"><input type="hidden" name="activo" value="<%= usuario.activo ? '' : 'on' %>"><button class="form-button form-button-secondary" type="submit"><%= usuario.activo ? 'Desactivar' : 'Activar' %></button></form><% } else { %>Sesión actual<% } %></td></tr><% }) %></tbody></table></div></section></div></main>
<%- include('../partials/footer') %>
