<%- include('../partials/header') %>
<main class="admin-management-page"><header class="admin-management-header"><div class="admin-dashboard-container"><div><p class="preinscripcion-kicker">SuperAdmin</p><h1>Conservación de datos</h1><p>Revisá las solicitudes y la trazabilidad de eliminación de datos.</p></div><a class="form-button form-button-secondary" href="/admin">Volver al panel</a></div></header><div class="admin-dashboard-container admin-management-content"><section class="admin-management-section"><div class="form-alert">La eliminación definitiva requiere una revisión administrativa y debe respetar la política de conservación aprobada por ETEC/UBA.</div><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Solicitud</th><th>Registro</th><th>Ciclo</th><th>Solicitada por</th><th>Fecha</th><th>Estado</th></tr></thead><tbody><% if (!solicitudes.length) { %><tr><td colspan="6">No hay solicitudes pendientes.</td></tr><% } %><% solicitudes.forEach((solicitud) => { %><tr><td><%= solicitud.id %></td><td>Número <%= solicitud.preinscripcion.numeroSorteo %></td><td><%= solicitud.preinscripcion.ciclo.anio %></td><td><%= solicitud.solicitadaPor.nombreMostrado %></td><td><%= new Date(solicitud.creadaEn).toLocaleString('es-AR') %></td><td><span class="admin-status-badge"><%= solicitud.ejecutadaEn ? 'Ejecutada' : 'Pendiente de revisión' %></span></td></tr><% }) %></tbody></table></div></section></div></main>
<%- include('../partials/footer') %>
