<%- include('../partials/header') %>
<main class="admin-audit-page">
  <header class="admin-audit-header"><div class="admin-dashboard-container admin-audit-header-inner"><div><p class="preinscripcion-kicker">SuperAdmin</p><h1>Auditoría</h1><p>Registro de accesos, cambios y exportaciones.</p></div><a class="form-button form-button-secondary" href="/admin">Volver al panel</a></div></header>
  <div class="admin-audit-container"><section class="admin-audit-card"><div class="admin-audit-card-heading"><div><h2>Actividad reciente</h2><p>Se muestran los últimos 200 registros. Los datos sensibles no se almacenan en este listado.</p></div><span class="admin-audit-count"><%= registros.length %> registros</span></div>
    <div class="admin-audit-table-wrapper"><table class="admin-audit-table"><thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Entidad</th><th>Detalle</th></tr></thead><tbody>
      <% if (!registros.length) { %><tr><td class="admin-audit-empty" colspan="5">Todavía no hay eventos registrados.</td></tr><% } %>
      <% registros.forEach((registro) => { let detalleFormateado = registro.detalles ?? '-'; let detalleObjeto = null; try { detalleObjeto = JSON.parse(registro.detalles ?? ''); detalleFormateado = JSON.stringify(detalleObjeto, null, 2); } catch { /* texto plano */ } const cambios = detalleObjeto && typeof detalleObjeto === 'object' ? Object.entries(detalleObjeto).filter(([clave]) => clave !== 'resultado') : []; %>
      <tr><td class="admin-audit-date"><%= new Date(registro.creadoEn).toLocaleDateString('es-AR') %><span><%= new Date(registro.creadoEn).toLocaleTimeString('es-AR') %></span></td><td class="admin-audit-user"><%= registro.usuario?.nombreMostrado ?? 'Sistema' %></td><td><span class="admin-audit-action"><%= registro.tipo.replaceAll('_', ' ') %></span></td><td><span class="admin-audit-entity"><%= registro.entidad ?? '-' %></span></td><td><details class="admin-audit-detail"><summary><span class="admin-audit-detail-icon">i</span> Ver qué se hizo</summary><div class="admin-audit-detail-panel"><p>Cambios realizados</p><% if (cambios.length) { %><div class="admin-audit-changes"><% cambios.forEach(([clave, valor]) => { const etiqueta = clave.replaceAll('_', ' ').replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, (c) => c.toUpperCase()); const texto = typeof valor === 'object' ? JSON.stringify(valor) : String(valor); %><div class="admin-audit-change"><span><%= etiqueta %></span><strong><%= texto %></strong></div><% }) %></div><% } else { %><div class="admin-audit-no-changes">Este registro no modificó contenido.</div><% } %></div></details></td></tr><% }) %>
    </tbody></table></div></section></div>
</main>
<%- include('../partials/footer') %>
