<div class="form-field"><label>Imagen de fondo<input type="text" data-media-url value="<%= fila[0] || '' %>" maxlength="500" placeholder="Subí una imagen o pegá su dirección"></label><input type="file" data-media-file accept="image/jpeg,image/png,image/webp" hidden><button type="button" data-media-upload class="form-button form-button-secondary">Subir imagen desde la computadora</button><small data-media-upload-status role="status"></small></div>
<div class="form-field"><label><%= portada ? 'Texto alternativo de la imagen' : 'Título visible del panel' %><input data-media-title type="text" value="<%= fila[1] || '' %>" maxlength="160"></label></div>
<% if (!portada) { %><div class="form-field"><label>Descripción sobre la imagen<textarea data-media-description rows="3" maxlength="500"><%= fila[2] || '' %></textarea></label></div><% } else { %><input type="hidden" data-media-description value="<%= fila[2] || '' %>"><% } %>
<input type="hidden" data-media-date value="<%= fila[3] || '' %>">
<button type="button" data-media-remove class="form-button form-button-secondary">Quitar elemento</button>
