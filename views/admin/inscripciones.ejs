<%- include('../partials/header') %>
<main class="admin-management-page"><header class="admin-management-header"><div class="admin-dashboard-container"><div><p class="preinscripcion-kicker">Gestión del ingreso</p><h1>Preinscripciones</h1><p>Consultá los registros del ciclo seleccionado.</p></div><a class="form-button form-button-secondary" href="/admin">Volver al panel</a></div></header>
<div class="admin-dashboard-container admin-management-content"><section class="admin-settings-card"><form class="admin-filter-form" method="get"><div class="form-field"><label for="buscar">Buscar por nombre, apellido o correo</label><input id="buscar" name="buscar" value="<%= busqueda %>" maxlength="80"></div><div class="form-field"><label for="ciclo">Ciclo lectivo</label><select id="ciclo" name="ciclo"><option value="">Todos</option><% ciclos.forEach((ciclo) => { %><option value="<%= ciclo.id %>" <%= cicloSeleccionado === ciclo.id ? 'selected' : '' %>><%= ciclo.anio %></option><% }) %></select></div><button class="form-button form-button-primary" type="submit">Buscar</button></form></section>
<section class="admin-management-section"><div class="admin-section-heading"><div><h2>Registros encontrados</h2><p>Se muestran hasta 200 resultados. El DNI no se expone en este listado.</p></div><a class="form-button form-button-secondary" href="/admin/exportaciones">Exportar</a></div><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Número</th><th>Aspirante</th><th>Ciclo</th><th>Contacto</th><th>Estado</th><th>Fecha</th></tr></thead><tbody><% if (!inscripciones.length) { %><tr><td colspan="6">No hay preinscripciones para mostrar.</td></tr><% } %><% inscripciones.forEach((registro) => { %><tr><td><strong><%= registro.numeroSorteo %></strong></td><td><%= registro.apellido %>, <%= registro.nombres %></td><td><%= registro.ciclo.anio %></td><td><%= registro.emailContacto %><br><small><%= registro.telefonoContacto %></small></td><td><span class="admin-status-badge"><%= registro.estado %></span></td><td><%= new Date(registro.creadoEn).toLocaleDateString('es-AR') %></td></tr><% }) %></tbody></table></div></section></div></main>
<%- include('../partials/footer') %>
