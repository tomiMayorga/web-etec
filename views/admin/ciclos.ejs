<%- include('../partials/header') %>
<main class="admin-management-page"><header class="admin-management-header"><div class="admin-dashboard-container"><div><p class="preinscripcion-kicker">SuperAdmin</p><h1>Ciclos y fechas</h1><p>Administrá los períodos de preinscripción y su estado.</p></div><a class="form-button form-button-secondary" href="/admin">Volver al panel</a></div></header><div class="admin-dashboard-container admin-management-content"><section class="admin-settings-card"><h2>Crear ciclo lectivo</h2><form method="post" action="/admin/ciclos" class="admin-settings-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label for="anio">Año</label><input id="anio" name="anio" type="number" min="2020" max="2100" required></div><div class="form-actions"><button class="form-button form-button-primary" type="submit">Crear ciclo</button></div></form></section><section class="admin-management-section"><h2>Ciclos existentes</h2><div class="admin-edit-grid"><% ciclos.forEach((ciclo) => { %><article class="admin-settings-card"><h3>Ciclo <%= ciclo.anio %></h3><p><%= ciclo._count.preinscripciones %> preinscripciones · próximo número <%= ciclo.proximoNumero %></p><form method="post" action="/admin/ciclos/estado" class="admin-settings-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= ciclo.id %>"><div class="form-field"><label for="estado-<%= ciclo.id %>">Estado</label><select id="estado-<%= ciclo.id %>" name="estado"><% ['BORRADOR','ABIERTO','CERRADO','ARCHIVADO'].forEach((estado) => { %><option value="<%= estado %>" <%= ciclo.estado === estado ? 'selected' : '' %>><%= estado %></option><% }) %></select></div><button class="form-button form-button-primary" type="submit">Guardar estado</button></form></article><% }) %></div></section></div></main>
<%- include('../partials/footer') %>
