<%- include('../partials/header') %>
<main class="admin-management-page"><header class="admin-management-header"><div class="admin-dashboard-container"><div><p class="preinscripcion-kicker">Gestión del ingreso</p><h1>Descargar listados</h1><p>Generá un archivo compatible con Excel del ciclo seleccionado.</p></div><a class="form-button form-button-secondary" href="/admin">Volver al panel</a></div></header><div class="admin-dashboard-container admin-management-content"><section class="admin-management-section"><div class="admin-edit-grid"><% ciclos.forEach((ciclo) => { %><article class="admin-settings-card"><h2>Ciclo <%= ciclo.anio %></h2><p><strong><%= ciclo._count.preinscripciones %></strong> preinscripciones registradas.</p><form method="post" action="/admin/exportaciones"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="ciclo" value="<%= ciclo.id %>"><button class="form-button form-button-primary" type="submit"><i class="fa-solid fa-file-excel" aria-hidden="true"></i> Descargar CSV</button></form></article><% }) %></div><% if (!ciclos.length) { %><div class="form-alert">Todavía no hay ciclos creados.</div><% } %><div class="form-alert">El archivo contiene datos personales y debe almacenarse únicamente en los equipos autorizados.</div></section></div></main>
<%- include('../partials/footer') %>
