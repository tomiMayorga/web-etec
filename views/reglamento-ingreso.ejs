<%- include('partials/header') %><% const bloques=(Array.isArray(seccionesReglamentoIngreso)?seccionesReglamentoIngreso:[]).filter(s=>s.activo); %><main class="admission-regulation-page"><section class="admission-regulation-layout"><article class="admission-regulation-document"><h1>Reglamento Curso de Ingreso Evaluatorio</h1><h2>REGLAMENTO CURSO DE INGRESO EVALUATORIO ETEC-UBA</h2><% bloques.forEach(b=>{ %><section><h3><%= b.titulo %></h3><% String(b.contenido||'').split(/\r?\n/).map(x=>x.trim()).filter(Boolean).forEach(linea=>{ %><p><%= linea %></p><% }) %></section><% }) %></article></section></main><%- include('partials/footer') %>
