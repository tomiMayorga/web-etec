              <li><a href="/tramites-para-alumnos-as">Trámites</a></li>
              <li><a href="/rematriculacion">Rematriculación</a></li>
              <li><a href="/regimen-academico">Régimen Académico</a></li>

              <li class="has-dropdown">
                <a href="#">
                  Prácticas Profesionalizantes
                  <i class="fa fa-chevron-right"></i>
                </a>

                <ul class="dropdown sub-dropdown">
                  <li><a href="/ega-imagen">EGA IMAGEN</a></li>
                  <li><a href="/tesacom">TESACOM</a></li>
                  <li><a href="/iadev">IADEV</a></li>
                  <li><a href="/laser">LASER</a></li>
                  <li><a href="/doit">DOIT+</a></li>
                  <li><a href="/green4t">GREEN4T</a></li>
                </ul>
              </li>
            </ul>
          </li>

          <li class="has-dropdown">
            <a href="#">
              Curso de Ingreso
