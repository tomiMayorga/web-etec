<%- include('partials/header') %><% const bloques=(Array.isArray(seccionesConvivencial)?seccionesConvivencial:[]).filter(s=>s.activo); %><main class="coexistence-page"><section class="coexistence-banner"><div class="coexistence-banner-inner"><h1>REGLAMENTO CONVIVENCIAL</h1></div></section><section class="coexistence-layout"><article class="coexistence-document"><h2>Reglamento de Convivencia de la Escuela Técnica de la Universidad de Buenos Aires</h2><nav class="coexistence-index" aria-label="Índice del reglamento"><h3>Índice</h3><ol><% bloques.forEach(b=>{ %><li><a href="#convivencia-<%= b.id %>"><%= b.titulo %></a></li><% }) %></ol></nav><% bloques.forEach(b=>{ %><section id="convivencia-<%= b.id %>" class="coexistence-section"><h3><%= b.titulo %></h3><% String(b.contenido||'').split(/\r?\n/).map(x=>x.trim()).filter(Boolean).forEach(linea=>{ %><p><%= linea %></p><% }) %></section><% }) %></article></section></main><%- include('partials/footer') %>
